<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <RootNamespace>McpNotebookLM</RootNamespace>
    <AssemblyName>McpNotebookLM.Login</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Compile Include="..\McpNotebookLM\Services\NotebookLmConfig.cs" Link="Services\NotebookLmConfig.cs" />
    <Compile Include="..\McpNotebookLM\Services\NotebookLmException.cs" Link="Services\NotebookLmException.cs" />
    <Compile Include="..\McpNotebookLM\Services\SessionStore.cs" Link="Services\SessionStore.cs" />
  </ItemGroup>

</Project>
